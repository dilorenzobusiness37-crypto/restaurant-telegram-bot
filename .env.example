# Bot token from @BotFather
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz

# Chat id of the restaurant owner: receives a message for every new/cancelled booking.
# Send /mioid to the bot to find yours. Leave empty to disable notifications.
OWNER_CHAT_ID=

# Optional: time zone used for "today"/"tomorrow" and past time slots
TIMEZONE=Europe/Rome

# Owner dashboard (python -m dashboard): password to log in. Required to start it,
# until the owner sets a new one from the dashboard's Impostazioni page.
DASHBOARD_PASSWORD=change-me
# Optional: use 0.0.0.0 to open the dashboard from a phone on the same Wi-Fi
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
